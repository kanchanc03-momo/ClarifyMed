# Choose one provider. Complete PDF reports up to 50 pages are supported; scanned
# pages are transcribed in small batches before one combined explanation.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional alternative: OpenAI also supports direct PDF reports.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5-mini
PORT=8787
NODE_ENV=development
DATABASE_URL=sqlite:./data/clarifymed.db
DATA_DIR=data
SESSION_SECRET=replace_with_a_long_random_secret
UPLOAD_DIRECTORY=
REPORT_RETENTION_DAYS=0
MAX_PDF_PAGES=50
ANALYSIS_TIMEOUT_MS=180000
ANALYSIS_TIMEOUT_MS=60000
# Use local for the offline Python ML service, groq, or openai.
ANALYSIS_PROVIDER=local
ML_SERVICE_URL=http://127.0.0.1:8000
# Pediatric wrist X-rays use this reviewed YOLOv8n checkpoint through the local ML service.
# The service verifies the checkpoint against evaluation.json and this expected SHA-256.
XRAY_MODEL_PATH=ml/artifacts/grazpedwri-yolo/model.pt
XRAY_EVALUATION_PATH=ml/artifacts/grazpedwri-yolo/evaluation.json
# Research/demo threshold selected using the validation split.
XRAY_SCORE_THRESHOLD=0.06749512255191803
# Set to 1 only when deployed behind one trusted reverse proxy.
TRUST_PROXY=0
