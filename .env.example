# Choose one provider. Groq accepts PDF reports (up to 5 pages), JPG and PNG.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Optional alternative: OpenAI also supports direct PDF reports.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5-mini
PORT=8787
DATA_DIR=data
ANALYSIS_TIMEOUT_MS=60000
# Use local for the offline Python ML service, groq, or openai.
ANALYSIS_PROVIDER=local
ML_SERVICE_URL=http://127.0.0.1:8000
# X-rays always use the local ML service, including when reports use Groq.
# Set only after an evaluated training run; no X-ray weights ship with the app.
# XRAY_MODEL_PATH=ml/artifacts/fracatlas-mobilenetv2/model.pt
# Set to 1 only when deployed behind one trusted reverse proxy.
TRUST_PROXY=0
